<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="channel" model="slide.channel">
        <field name="name">تصميم مقترح ثقافي قابل للتمويل والتقييم</field>
        <field name="channel_type">training</field>
        <field name="enroll">public</field>
        <field name="visibility">public</field>
        <field name="description_short" type="html"><p dir="rtl">ابنِ ملف تمويل لمختبر مسرح مجتمعي، من قرار التقدّم حتى الدفاع عن الميزانية والنتائج.</p></field>
        <field name="description" type="html"><div lang="ar" dir="rtl"><p>ورشة متقدمة لمن سبق له إعداد نشاط ثقافي أو قراءة دعوة تمويل. تحتاج إلى ورقة حسابية ومستند نصي. خصّص ثلاث ساعات تشمل العمل المستقل. بيانات الدعوة والمسرح افتراضية ومتاحة كاملة هنا.</p><p>تخرج بمذكرة قرار، ومصفوفة نتائج، وميزانية قابلة للتعديل. احتفظ بالمسودات في ملف واحد واستخدم سلم المراجعة قبل الاختبار.</p></div></field>
        <field name="image_1920" type="base64" file="nova_course_proposal_writing/static/img/workshop.jpg"/>
        <field name="is_published" eval="True"/>
    </record>

    <record id="section_1" model="slide.slide">
        <field name="name">قراءة الدعوة واتخاذ قرار التقدّم</field>
        <field name="channel_id" ref="channel"/>
        <field name="is_category" eval="True"/>
        <field name="sequence">1</field>
        <field name="slide_category">document</field>
        <field name="is_published" eval="True"/>
    </record>

    <record id="slide_1_1" model="slide.slide">
        <field name="name">قرار التقدّم وشروط الأهلية</field>
        <field name="channel_id" ref="channel"/>
        <field name="sequence">2</field>
        <field name="slide_category">article</field>
        <field name="completion_time">0.5</field>
        <field name="is_published" eval="True"/>
        <field name="is_preview" eval="True"/>
        <field name="description">استخرج من الدعوة ما يحسم أهلية الطلب وما يؤثر في ترتيبه.</field>
        <field name="html_content" type="html"><div dir="rtl" lang="ar" style="max-width:48rem;margin:auto;line-height:1.85;text-align:right;overflow-wrap:break-word;">
<p style="color:#713e59;font-size:1.2rem;font-weight:600;">استخرج من الدعوة ما يحسم أهلية الطلب وما يؤثر في ترتيبه.</p>
<h2>شروط الدعوة</h2>
<dl class="row mx-0" style="background:#f0f4f5;color:#20343c;border-radius:.75rem;padding:.75rem;">
<div class="col-12 col-sm-4 py-1"><dt>الأهلية</dt><dd class="mb-0">خطاب موقّع</dd></div>
<div class="col-12 col-sm-4 py-1"><dt>السقف</dt><dd class="mb-0">٣٠٠٠ وحدة</dd></div>
<div class="col-12 col-sm-4 py-1"><dt>الإغلاق</dt><dd class="mb-0">بعد خمسة أيام</dd></div>
</dl>
<p>تدعو مؤسسة افتراضية فرقاً ثقافية إلى برنامج مدته أربعة أشهر. سقف المنحة ٣٠٠٠ وحدة نقدية. تشترط الدعوة شريكاً محلياً يوقّع قبل الإغلاق، ولا تغطي شراء معدات. يحصل التصميم الفني على ٤٠ نقطة، والوصول إلى الجمهور على ٣٥، والجدوى على ٢٥. بقيت خمسة أيام. المسرح متاح شفهياً، والمنسقة قادرة على الاتصال به اليوم.</p>
<h2>طريقة العمل</h2>
<p>أنشئ جدولاً بأعمدة «النص الملزم، الدليل المتاح، الفجوة، المسؤول، آخر موعد». افصل بين شرط يسقط الطلب ونقطة يمكن تحسينها. مثلاً، تؤثر خطة الوصول الضعيفة في ترتيب طلب مؤهل، فيما يعرّض غياب التوقيع الطلب للاستبعاد مهما بلغت جودته الفنية.</p>
<div style="border-right:4px solid #713e59;background:#faf7f2;color:#29251f;padding:1rem;margin:1.25rem 0;"><h2>مهمتك</h2><p class="mb-0">اكتب مذكرة من ١٢٠ كلمة تحدد متى يتوقف الفريق عن الكتابة. عيّن شخصاً يجمع الدليل وشخصاً يقرر الاستمرار. أضف بنداً يوضح كيف ستتعامل مع كاميرا كان الفريق ينوي شراءها.</p></div>
<h2>راجع إجابتك</h2>
<p>قرار مشروط بتسلّم خطاب الشريك قبل الإغلاق بيومين. تطلب المنسقة الخطاب اليوم وتتحقق من اسم الجهة وصلاحية الموقّع. يستخدم الفريق كاميرا متاحة بإذن صاحبها ويستبعد الشراء من الطلب. إذا فات الموعد الداخلي يراجع المدير إمكانية الحصول على التوقيع فعلياً قبل الالتزام بمزيد من العمل.</p>
</div></field>
    </record>

    <record id="slide_1_2" model="slide.slide">
        <field name="name">من نظرية التغيير إلى تصميم قابل للاختبار</field>
        <field name="channel_id" ref="channel"/>
        <field name="sequence">3</field>
        <field name="slide_category">article</field>
        <field name="completion_time">0.5</field>
        <field name="is_published" eval="True"/>
        <field name="is_preview" eval="False"/>
        <field name="description">اختبر الحلقة الأضعف بين النشاط والنتيجة الفنية.</field>
        <field name="html_content" type="html"><div dir="rtl" lang="ar" style="max-width:48rem;margin:auto;line-height:1.85;text-align:right;overflow-wrap:break-word;">
<p style="color:#713e59;font-size:1.2rem;font-weight:600;">اختبر الحلقة الأضعف بين النشاط والنتيجة الفنية.</p>
<h2>سلسلة التغيير</h2>
<dl class="row mx-0" style="background:#f0f4f5;color:#20343c;border-radius:.75rem;padding:.75rem;">
<div class="col-12 col-sm-4 py-1"><dt>النشاط</dt><dd class="mb-0">ارتجال ثنائي</dd></div>
<div class="col-12 col-sm-4 py-1"><dt>التغذية الراجعة</dt><dd class="mb-0">ملاحظة من الزملاء</dd></div>
<div class="col-12 col-sm-4 py-1"><dt>دليل التغيّر</dt><dd class="mb-0">مشهد قبل التعديل وبعده</dd></div>
</dl>
<p>يريد المختبر أن يتمكن المشاركون من بناء مشهد جماعي. المكان يتسع لعشرين شخصاً. تقترح المسودة ست جلسات يعقبها عرض، ثم تعد بأن العرض سيحسّن التماسك الاجتماعي في المدينة. يستطيع الفريق ملاحظة البروفات، ولا يملك بيانات عن سكان المدينة.</p>
<h2>طريقة العمل</h2>
<p>ابنِ سلسلة تبدأ بتمرين ارتجال ثنائي ثم مراجعة بين الأقران ثم إعادة أداء المشهد. صِف التغير المتوقع في الأداء، واختر دليلاً يميّزه عن مجرد الحضور. اختبر الافتراض الذي يصل المراجعة بإعادة الأداء. إذا لم يحصل كل ثنائي على وقت للتعديل انقطعت السلسلة.</p>
<div style="border-right:4px solid #713e59;background:#faf7f2;color:#29251f;padding:1rem;margin:1.25rem 0;"><h2>مهمتك</h2><p class="mb-0">ارسم السلسلة في أربعة أعمدة وأضف افتراضاً ومؤشراً مبكراً وخيار تعديل. اشرح في سطر واحد أي ادعاء تحذفه من المسودة ولماذا.</p></div>
<h2>راجع إجابتك</h2>
<p>منجز الجلسة مشهد مسجل بموافقة أصحابه أو بطاقة ملاحظة مكتوبة. النتيجة أن الثنائي يستطيع تعديل بناء المشهد استجابة لملاحظة محددة. إذا لم تُعد نصف الثنائيات الأداء خلال الجلسة الثالثة، نقلّل عدد المشاهد المعروضة ونحفظ وقتاً للمحاولة الثانية.</p>
</div></field>
    </record>

    <record id="section_2" model="slide.slide">
        <field name="name">بناء الحجة واختبار الموارد</field>
        <field name="channel_id" ref="channel"/>
        <field name="is_category" eval="True"/>
        <field name="sequence">4</field>
        <field name="slide_category">document</field>
        <field name="is_published" eval="True"/>
    </record>

    <record id="slide_2_1" model="slide.slide">
        <field name="name">تصميم مؤشر وحساب المقام</field>
        <field name="channel_id" ref="channel"/>
        <field name="sequence">5</field>
        <field name="slide_category">article</field>
        <field name="completion_time">0.5</field>
        <field name="is_published" eval="True"/>
        <field name="is_preview" eval="False"/>
        <field name="description">حدّد المقام وخط الأساس وطريقة تفسير الانسحاب.</field>
        <field name="html_content" type="html"><div dir="rtl" lang="ar" style="max-width:48rem;margin:auto;line-height:1.85;text-align:right;overflow-wrap:break-word;">
<p style="color:#713e59;font-size:1.2rem;font-weight:600;">حدّد المقام وخط الأساس وطريقة تفسير الانسحاب.</p>
<h2>مجموعة القياس</h2>
<dl class="row mx-0" style="background:#f0f4f5;color:#20343c;border-radius:.75rem;padding:.75rem;">
<div class="col-12 col-sm-4 py-1"><dt>المسجّلون</dt><dd class="mb-0">٢٠ شخصاً</dd></div>
<div class="col-12 col-sm-4 py-1"><dt>أصحاب القياسين</dt><dd class="mb-0">١٦ شخصاً</dd></div>
<div class="col-12 col-sm-4 py-1"><dt>تحسّن مثبت</dt><dd class="mb-0">١٢ شخصاً</dd></div>
</dl>
<p>سجّل ٢٠ شخصاً، وحضر ١٦ منهم التمرينين القبلي والبعدي. تحسّن ١٢ من هؤلاء درجة واحدة على الأقل. تقيس البطاقة وضوح التحول الدرامي من صفر إلى درجتين. الصفر غياب التحول، والواحد تحول يظهر بعد شرح المؤدي، والاثنتان تحول يدركه الملاحظ من الأداء.</p>
<h2>طريقة العمل</h2>
<p>احسب ١٢ ÷ ١٦ لتحصل على ٧٥٪ من أصحاب القياسين. وبالنسبة إلى المسجلين جميعاً، ثبت التحسن لدى ٦٠٪. اذكر الأربعة الذين تعذر قياسهم. إذا كان الأكثر تعثراً هم الذين غابوا، فقد تكون مجموعة القياسين منحازة.</p>
<div style="border-right:4px solid #713e59;background:#faf7f2;color:#29251f;padding:1rem;margin:1.25rem 0;"><h2>مهمتك</h2><p class="mb-0">اكتب بطاقة مؤشر تتضمن التعريف والبسط والمقام ووقت الرصد والمسؤول وحدود التفسير. اتفق مع ملاحظ ثانٍ على تقييم مشهدين بصورة مستقلة ثم قارنا سبب الاختلاف.</p></div>
<h2>راجع إجابتك</h2>
<p>تسجّل المنسقة الدرجات برموز داخلية بعد الجلستين الأولى والأخيرة. تذكر النتيجة ١٢ من ١٦، وتعرض عدد المسجلين والمفقودين إلى جانبها. لا يمكن استنتاج سبب التحسن من هذا القياس وحده.</p>
<h2>قراءة مرتبطة بالتمرين</h2><p>راجع مدخلَي خط الأساس ومؤشر الأداء عند إعداد بطاقة القياس. <a href="https://www.oecd.org/content/dam/oecd/ar/publications/reports/2023/06/glossary-of-key-terms-in-evaluation-and-results-based-management-for-sustainable-development-second-edition_2767e14e/b98b182b-ar-en-fr.pdf">معجم التقييم والإدارة القائمة على النتائج بالعربية (PDF)</a></p>
</div></field>
    </record>

    <record id="slide_2_1_q1" model="slide.question">
        <field name="question">تحسّن ١٢ مشاركاً من ١٦ لديهم قياسان، من أصل ٢٠ مسجلاً. أي عبارة تصلح للتقرير؟</field>
        <field name="sequence">1</field>
        <field name="slide_id" ref="slide_2_1"/>
    </record>
    <record id="slide_2_1_q1_a1" model="slide.answer">
        <field name="text_value">تحسّن ٧٥٪ من المسجلين</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="False"/>
        <field name="question_id" ref="slide_2_1_q1"/>
        <field name="comment">المقام هنا ١٦، بينما عدد المسجلين ٢٠.</field>
    </record>
    <record id="slide_2_1_q1_a2" model="slide.answer">
        <field name="text_value">تحسّن ١٢ من أصحاب القياسين وتعذّر قياس أربعة مسجلين</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="True"/>
        <field name="question_id" ref="slide_2_1_q1"/>
        <field name="comment">تحفظ الصياغة المقام وحدود الرصد.</field>
    </record>
    <record id="slide_2_1_q1_a3" model="slide.answer">
        <field name="text_value">لم يتحسن الأربعة الغائبون</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="question_id" ref="slide_2_1_q1"/>
        <field name="comment">الغياب يترك النتيجة مجهولة.</field>
    </record>
    <record id="slide_2_1_q1_a4" model="slide.answer">
        <field name="text_value">أثبت المختبر أن التدريب وحده سبّب التحسن</field>
        <field name="sequence">4</field>
        <field name="is_correct" eval="False"/>
        <field name="question_id" ref="slide_2_1_q1"/>
        <field name="comment">لا يعزل القياس أثر العوامل الأخرى.</field>
    </record>

    <record id="slide_2_2" model="slide.slide">
        <field name="name">صياغة الحاجة وحدود الدليل</field>
        <field name="channel_id" ref="channel"/>
        <field name="sequence">6</field>
        <field name="slide_category">article</field>
        <field name="completion_time">0.5</field>
        <field name="is_published" eval="True"/>
        <field name="is_preview" eval="False"/>
        <field name="description">وازن بين إفادات الشركاء وبيانات المشاركين قبل تثبيت تصميمك.</field>
        <field name="html_content" type="html"><div dir="rtl" lang="ar" style="max-width:48rem;margin:auto;line-height:1.85;text-align:right;overflow-wrap:break-word;">
<p style="color:#713e59;font-size:1.2rem;font-weight:600;">وازن بين إفادات الشركاء وبيانات المشاركين قبل تثبيت تصميمك.</p>
<h2>وزن الدليل</h2>
<dl class="row mx-0" style="background:#f0f4f5;color:#20343c;border-radius:.75rem;padding:.75rem;">
<div class="col-12 col-sm-4 py-1"><dt>العينة</dt><dd class="mb-0">١٢ من الرواد</dd></div>
<div class="col-12 col-sm-4 py-1"><dt>صعوبة العودة</dt><dd class="mb-0">٨ إفادات</dd></div>
<div class="col-12 col-sm-4 py-1"><dt>السجل</dt><dd class="mb-0">٣ فعاليات مسائية</dd></div>
</dl>
<p>في مقابلات مع ١٢ شخصاً من رواد المسرح ذكر ثمانية صعوبة العودة مساءً. تفيد سجلات القاعة بأن آخر ثلاث فعاليات بدأت بعد السابعة. لم تشمل المقابلات أشخاصاً توقفوا عن الحضور. يقترح الشريك تقديم الورش صباحاً.</p>
<h2>طريقة العمل</h2>
<p>تدعم المقابلات فرضية أن التوقيت يعرقل مشاركة بعض الرواد. توثق السجلات وقت البدء فقط. استمع إلى مجموعة لم تصل إليها المقابلات واختبر موعدين قبل الحجز. دوّن ما قد يدفعك إلى العدول عن الحل المقترح.</p>
<div style="border-right:4px solid #713e59;background:#faf7f2;color:#29251f;padding:1rem;margin:1.25rem 0;"><h2>مهمتك</h2><p class="mb-0">اكتب فقرة حاجة من ٩٠ كلمة، ثم سؤالاً واحداً تسأله للغائبين دون افتراض أن النقل هو العائق. اربط الإجابة بقرار يمكن تغييره قبل التعاقد.</p></div>
<h2>راجع إجابتك</h2>
<p>صياغة منضبطة تنسب الثمانية إلى العينة المقابَلة. يمكن السؤال «أي المواعيد تستطيع الالتزام به طوال ست جلسات، وما الذي يصعّب ذلك؟». إذا استبعد العاملون الموعد الصباحي، جرّب موعداً أبكر مساءً قبل تثبيت الجدول.</p>
</div></field>
    </record>

    <record id="slide_2_3" model="slide.slide">
        <field name="name">مختبر الميزانية ومراجعة الملف</field>
        <field name="channel_id" ref="channel"/>
        <field name="sequence">7</field>
        <field name="slide_category">article</field>
        <field name="completion_time">0.5</field>
        <field name="is_published" eval="True"/>
        <field name="is_preview" eval="False"/>
        <field name="description">سوِّ بنود التكلفة مع سقف المنحة وتدفق النقد ثم راجع الملف كاملاً.</field>
        <field name="html_content" type="html"><div dir="rtl" lang="ar" style="max-width:48rem;margin:auto;line-height:1.85;text-align:right;overflow-wrap:break-word;">
<p style="color:#713e59;font-size:1.2rem;font-weight:600;">سوِّ بنود التكلفة مع سقف المنحة وتدفق النقد ثم راجع الملف كاملاً.</p>
<h2>تدفق النقد</h2>
<dl class="row mx-0" style="background:#f0f4f5;color:#20343c;border-radius:.75rem;padding:.75rem;">
<div class="col-12 col-sm-4 py-1"><dt>الطلب الأصلي</dt><dd class="mb-0">٢٦٠٠ وحدة</dd></div>
<div class="col-12 col-sm-4 py-1"><dt>المستحق المبكر</dt><dd class="mb-0">٢١٠٠ وحدة</dd></div>
<div class="col-12 col-sm-4 py-1"><dt>الدفعة الأولى</dt><dd class="mb-0">٧٠٪</dd></div>
</dl>
<p>تكلّف ست جلسات تدريب ١٥٠ لكل جلسة، وسبعة أيام قاعة ٥٠ لليوم، والمواد ٣٠٠، والإتاحة والنقل ٦٠٠، والعرض ٤٥٠. تدفع الجهة ٧٠٪ من المبلغ المطلوب عند التوقيع والباقي بعد التقرير. يلزم دفع ٢١٠٠ قبل التقرير ولا يوجد رصيد حر.</p>
<h2>طريقة العمل</h2>
<p>المجموع ٢٦٠٠، والدفعة الأولى ١٨٢٠، والفجوة النقدية ٢٨٠. وجود هامش تحت سقف المنحة لا يسدد فاتورة مستحقة. اطلب جدول استحقاق مكتوباً أو تمويلاً مرحلياً مؤكداً قبل توقيع العقد. سجّل أثر أي تعديل على المشاركين.</p>
<div style="border-right:4px solid #713e59;background:#faf7f2;color:#29251f;padding:1rem;margin:1.25rem 0;"><h2>مهمتك</h2><p class="mb-0">سلّم لنفسك ملفاً من صفحتين وجدول تكلفة. اختبر زيادة إيجار اليوم إلى ٧٠ مع استحقاق الزيادة كاملة قبل التقرير. احسب الطلب والدفعة الأولى والفجوة الجديدة، وحدد من يتفاوض ومتى يُعتمد البديل.</p></div>
<h2>راجع إجابتك</h2>
<p>يزيد الإيجار ١٤٠، فيصبح الطلب ٢٧٤٠ والدفعة الأولى ١٩١٨ والمستحق المبكر ٢٢٤٠ والفجوة ٣٢٢. امنح ملفك نقطة لكل دليل ظاهر فيه: توقيع الشريك، وحدود العينة، ومقام المؤشر، وحساب الفجوة، وقرار تغطيتها. أعد تحرير كل بند غاب دليله قبل عرض الملف على مراجع.</p>
</div></field>
