        <field name="is_correct" eval="False"/>
        <field name="question_id" ref="slide_2_1_q1"/>
        <field name="comment">الفئة موجودة: الأطفال.</field>
    </record>
    <record id="slide_2_1_q1_a4" model="slide.answer">
        <field name="text_value">لا شيء، الهدف ذكي</field>
