<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Course: كتابة مقترح مشروع ثقافي ناجح ===== -->
    <record id="channel" model="slide.channel">
        <field name="name">كتابة مقترح مشروع ثقافي ناجح</field>
        <field name="channel_type">training</field>
        <field name="enroll">public</field>
        <field name="visibility">public</field>
        <field name="description_short" type="html"><p dir="rtl">حوّل فكرتك الثقافية إلى مقترح واضح ومقنع في حوالي 70 دقيقة.</p></field>
        <field name="description" type="html"><div dir="rtl"><p>دورة ذاتية قصيرة للفنانين والمجموعات والمؤسسات الثقافية الصغيرة. تتعلّم فيها خطوة بخطوة كيف تحدّد الحاجة، وتكتب أهدافاً ذكية، وتربط الأنشطة بالنتائج، وتُعدّ ميزانية وجدولاً زمنياً واقعيين.</p><p>كل درس يتضمّن مثالاً من الواقع وتمريناً تطبيقياً، وتنتهي الدورة باختبار نهائي.</p></div></field>
        <field name="image_1920" type="base64" file="nova_course_proposal_writing/static/img/cover.png"/>
        <field name="is_published" eval="True"/>
    </record>

    <!-- Section 1: الوحدة 1: الأساسيات -->
    <record id="section_1" model="slide.slide">
        <field name="name">الوحدة 1: الأساسيات</field>
        <field name="channel_id" ref="channel"/>
        <field name="is_category" eval="True"/>
        <field name="sequence">1</field>
        <field name="slide_category">document</field>
        <field name="is_published" eval="True"/>
    </record>

    <record id="slide_1_1" model="slide.slide">
        <field name="name">ما هو المقترح ولماذا يهمّ؟</field>
        <field name="channel_id" ref="channel"/>
        <field name="sequence">2</field>
        <field name="slide_category">article</field>
        <field name="completion_time">0.1333</field>
        <field name="is_published" eval="True"/>
        <field name="is_preview" eval="True"/>
        <field name="description">ما الذي تبحث عنه الجهة المانحة، والأجزاء الأساسية لأي مقترح.</field>
        <field name="html_content" type="html"><div dir="rtl" style="text-align:right;font-size:17px;line-height:1.9;">
<h3>لماذا تكتب مقترحاً؟</h3>
<p>المقترح هو الوثيقة التي تقنع جهة مانحة أو شريكاً بأن فكرتك تستحق الدعم. هو ليس وصفاً لأحلامك، بل خطة واضحة تجيب عن سؤال واحد: ما المشكلة، وكيف ستساهم في حلّها؟</p>
<h3>الأجزاء الأساسية لأي مقترح</h3>
<ol><li><b>ملخّص المشروع:</b> فقرة واحدة تشرح الفكرة كاملة.</li><li><b>الحاجة أو المشكلة:</b> لماذا هذا المشروع مهم الآن، ولمن؟</li><li><b>الأهداف:</b> ما الذي ستحقّقه بشكل قابل للقياس.</li><li><b>الأنشطة:</b> ماذا ستفعل بالضبط لتحقيق الأهداف.</li><li><b>النتائج المتوقّعة وطريقة التقييم.</b></li><li><b>الميزانية والجدول الزمني.</b></li><li><b>الفريق والشركاء.</b></li></ol>
<div style="background:#ecf8f1;border:1px solid #bfe5cf;border-radius:12px;padding:14px 18px;margin:16px 0;"><p style="color:#14653f;font-weight:bold;margin:0 0 6px;">قاعدة ذهبية</p><p>اقرأ دعوة التقديم مرتين قبل أن تكتب. استخدم كلمات الجهة المانحة نفسها، وأجب عن كل سؤال تطرحه بالترتيب.</p></div>
<div style="background:#fbf8fa;border:1px solid #c9b6c4;border-radius:12px;padding:14px 18px;margin:16px 0;"><p style="color:#714B67;font-weight:bold;margin:0 0 6px;">✍ تمرين (3 دقائق)</p><p>اكتب في ثلاثة أسطر: ما فكرة مشروعك؟ ولمن هو؟ ولماذا الآن؟</p></div>
</div></field>
    </record>

    <record id="slide_1_2" model="slide.slide">
        <field name="name">قصة من الميدان: مشروع مسرح مجتمعي</field>
        <field name="channel_id" ref="channel"/>
        <field name="sequence">3</field>
        <field name="slide_category">article</field>
        <field name="completion_time">0.0667</field>
        <field name="is_published" eval="True"/>
        <field name="is_preview" eval="False"/>
        <field name="description">كيف تحوّلت فكرة بسيطة إلى مشروع مموَّل.</field>
        <field name="html_content" type="html"><div dir="rtl" style="text-align:right;font-size:17px;line-height:1.9;">
<p>بدأت مجموعة شبابية صغيرة في صيدا بفكرة: ورش مسرحية لليافعين في الأحياء التي تفتقر إلى مساحات ثقافية. في المحاولة الأولى رُفض المقترح لأنه كان عامّاً: «دعم الشباب من خلال الفن».</p>
<p>في المحاولة الثانية أعادت المجموعة الكتابة: حدّدت الحي، وعدد المشاركين، وعدد الورش، والمدة، ونتيجة واضحة هي عرض جماهيري في نهاية المشروع. هذه المرة حصلت على التمويل.</p>
<div style="background:#fff8ec;border:1px solid #f6d9a8;border-radius:12px;padding:14px 18px;margin:16px 0;"><p style="color:#5a4320;font-weight:bold;margin:0 0 6px;">ماذا تغيّر؟</p><ul><li>مشكلة موثّقة بأرقام بسيطة من الحي</li><li>أهداف محدّدة وقابلة للقياس</li><li>ميزانية صغيرة وواقعية تتناسب مع حجم الفريق</li></ul></div>
<div style="background:#ecf8f1;border:1px solid #bfe5cf;border-radius:12px;padding:14px 18px;margin:16px 0;"><p style="color:#14653f;font-weight:bold;margin:0 0 6px;">ملاحظة للمصمّم</p><p>في الدورة الحقيقية يمكن أن يكون هذا الدرس فيديو قصيراً مضغوطاً مع هذا النص كبديل مكتوب.</p></div>
</div></field>
    </record>

