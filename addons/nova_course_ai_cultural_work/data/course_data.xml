<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Course: الذكاء الاصطناعي في العمل الثقافي: استخدام آمن ومسؤول ===== -->
    <record id="channel" model="slide.channel">
        <field name="name">الذكاء الاصطناعي في العمل الثقافي: استخدام آمن ومسؤول</field>
        <field name="channel_type">training</field>
        <field name="enroll">public</field>
        <field name="visibility">public</field>
        <field name="description_short" type="html"><p dir="rtl">استخدم أدوات الذكاء الاصطناعي لتوفير الوقت في الكتابة والترجمة والتلخيص، دون التضحية بالدقة أو الخصوصية، في حوالي ساعة.</p></field>
        <field name="description" type="html"><div dir="rtl"><p>دورة عملية للفنانين والعاملين في المؤسسات الثقافية. تتعلّم فيها ما تستطيع أدوات الذكاء الاصطناعي التوليدي فعله وما لا تستطيعه، وكيف تكتب طلبات واضحة، وتستخدمها في المسودات والترجمة والتلخيص، مع مراجعة بشرية دائمة وحماية للبيانات.</p><p>لا تحتاج إلى خبرة تقنية. كل درس يتضمّن مثالاً من الواقع وتمريناً تطبيقياً.</p></div></field>
        <field name="image_1920" type="base64" file="nova_course_ai_cultural_work/static/img/cover.png"/>
        <field name="is_published" eval="True"/>
    </record>

    <!-- Section 1: الوحدة 1: الأساسيات -->
    <record id="section_1" model="slide.slide">
        <field name="name">الوحدة 1: الأساسيات</field>
        <field name="channel_id" ref="channel"/>
        <field name="is_category" eval="True"/>
        <field name="sequence">1</field>
        <field name="slide_category">document</field>
        <field name="is_published" eval="True"/>
    </record>

    <record id="slide_1_1" model="slide.slide">
        <field name="name">ما الذي يستطيع الذكاء الاصطناعي فعله لك؟</field>
        <field name="channel_id" ref="channel"/>
        <field name="sequence">2</field>
        <field name="slide_category">article</field>
        <field name="completion_time">0.1333</field>
        <field name="is_published" eval="True"/>
        <field name="is_preview" eval="True"/>
        <field name="description">نقاط القوة والضعف في أدوات الذكاء الاصطناعي التوليدي.</field>
        <field name="html_content" type="html"><div dir="rtl" style="text-align:right;font-size:17px;line-height:1.9;">
<p>أدوات الذكاء الاصطناعي التوليدي هي برامج تكتب نصوصاً أو تلخّصها أو تترجمها بناءً على طلب تكتبه أنت. يمكن أن توفّر عليك ساعات من العمل، لكنها ليست مصدراً موثوقاً للحقائق.</p>
<h3>أين تساعدك فعلاً؟</h3>
<ul><li>كتابة مسودة أولى لرسالة أو منشور أو ملخّص مشروع</li><li>إعادة صياغة نص طويل بلغة أبسط</li><li>ترجمة أولية بين العربية والإنجليزية</li><li>تلخيص تقرير أو محضر اجتماع</li><li>اقتراح أفكار لعناوين أو أنشطة</li></ul>
<div style="background:#fdf0f0;border:1px solid #f3c9c9;border-radius:12px;padding:14px 18px;margin:16px 0;"><p style="color:#b23b3b;font-weight:bold;margin:0 0 6px;">حدودها</p><ul><li>قد «تخترع» معلومات أو مراجع تبدو مقنعة لكنها خاطئة</li><li>لا تعرف سياقك المحلي إلا إذا شرحته لها</li><li>قد تحتفظ الخدمة بما تكتبه، فلا تضع فيها بيانات حساسة</li></ul></div>
<div style="background:#ecf8f1;border:1px solid #bfe5cf;border-radius:12px;padding:14px 18px;margin:16px 0;"><p style="color:#14653f;font-weight:bold;margin:0 0 6px;">القاعدة الذهبية</p><p>الذكاء الاصطناعي يكتب المسودة، وأنت تبقى المسؤول عن النتيجة النهائية.</p></div>
<div style="background:#fbf8fa;border:1px solid #c9b6c4;border-radius:12px;padding:14px 18px;margin:16px 0;"><p style="color:#714B67;font-weight:bold;margin:0 0 6px;">✍ تمرين (3 دقائق)</p><p>اكتب ثلاث مهام متكرّرة في عملك الأسبوعي يمكن أن يساعدك فيها الذكاء الاصطناعي.</p></div>
</div></field>
    </record>

    <record id="slide_1_2" model="slide.slide">
        <field name="name">كيف تكتب طلباً جيداً</field>
        <field name="channel_id" ref="channel"/>
        <field name="sequence">3</field>
        <field name="slide_category">article</field>
        <field name="completion_time">0.2</field>
        <field name="is_published" eval="True"/>
        <field name="is_preview" eval="False"/>
        <field name="description">خمسة عناصر تجعل النتيجة أدقّ وأقرب لما تريد.</field>
        <field name="html_content" type="html"><div dir="rtl" style="text-align:right;font-size:17px;line-height:1.9;">
<p>جودة النتيجة تعتمد على جودة الطلب. الطلب الغامض يعطي نتيجة عامة، والطلب الواضح يعطي نتيجة قابلة للاستخدام.</p>
<table style="width:100%;border-collapse:collapse;" border="1" cellpadding="8"><tr style="background:#eef2ff;"><th>العنصر</th><th>السؤال الذي يجيب عنه</th><th>مثال</th></tr><tr><td><b>الدور</b></td><td>من يجب أن يكون المساعد؟</td><td>«تصرّف كمحرّر خبير في المنح الثقافية»</td></tr><tr><td><b>المهمة</b></td><td>ماذا تريد بالضبط؟</td><td>«اكتب ملخّصاً للمشروع»</td></tr><tr><td><b>السياق</b></td><td>ما المعلومات التي يحتاجها؟</td><td>«ورش مسرح لـ 60 شاباً في صيدا خلال 4 أشهر»</td></tr><tr><td><b>الشكل</b></td><td>كيف تريد النتيجة؟</td><td>«فقرة واحدة، 120 كلمة، بالعربية الفصحى»</td></tr><tr><td><b>القيود</b></td><td>ما الذي يجب تجنّبه؟</td><td>«لا تخترع أرقاماً أو شركاء»</td></tr></table>
<div style="background:#fdf0f0;border:1px solid #f3c9c9;border-radius:12px;padding:14px 18px;margin:16px 0;"><p style="color:#b23b3b;font-weight:bold;margin:0 0 6px;">✕ طلب ضعيف</p><p>«اكتب لي عن مشروعي.»</p></div>
<div style="background:#ecf8f1;border:1px solid #bfe5cf;border-radius:12px;padding:14px 18px;margin:16px 0;"><p style="color:#14653f;font-weight:bold;margin:0 0 6px;">✓ طلب واضح</p><p>«تصرّف كمحرّر خبير في المنح الثقافية. اكتب ملخّصاً لمشروع ورش مسرح لـ 60 شاباً في صيدا خلال 4 أشهر. فقرة واحدة من 120 كلمة بالعربية الفصحى. لا تخترع أرقاماً أو شركاء.»</p></div>
<div style="background:#fbf8fa;border:1px solid #c9b6c4;border-radius:12px;padding:14px 18px;margin:16px 0;"><p style="color:#714B67;font-weight:bold;margin:0 0 6px;">✍ تمرين (5 دقائق)</p><p>أعد كتابة طلب استخدمته سابقاً باستخدام العناصر الخمسة، وقارن النتيجتين.</p></div>
</div></field>
    </record>

    <record id="slide_1_2_q1" model="slide.question">
        <field name="question">أيّ عنصر ينقص هذا الطلب: «اكتب منشوراً عن معرضنا الفني»؟</field>
        <field name="sequence">1</field>
        <field name="slide_id" ref="slide_1_2"/>
    </record>
    <record id="slide_1_2_q1_a1" model="slide.answer">
        <field name="text_value">السياق والشكل: تفاصيل المعرض وطول المنشور ونبرته</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="True"/>
        <field name="question_id" ref="slide_1_2_q1"/>
        <field name="comment">بدون تفاصيل المعرض والشكل المطلوب ستكون النتيجة عامة.</field>
    </record>
    <record id="slide_1_2_q1_a2" model="slide.answer">
        <field name="text_value">لا شيء، الطلب كامل</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="False"/>
        <field name="question_id" ref="slide_1_2_q1"/>
        <field name="comment">الطلب لا يذكر التاريخ أو المكان أو الجمهور أو الطول.</field>
    </record>
    <record id="slide_1_2_q1_a3" model="slide.answer">
        <field name="text_value">كلمة «من فضلك»</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="question_id" ref="slide_1_2_q1"/>
        <field name="comment">اللطف جيد، لكنه لا يحسّن دقة النتيجة.</field>
    </record>

