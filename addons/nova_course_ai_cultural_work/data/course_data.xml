<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="channel" model="slide.channel">
        <field name="name">التحرير الثقافي بالذكاء الاصطناعي تحت إشراف بشري</field>
        <field name="channel_type">training</field>
        <field name="enroll">public</field>
        <field name="visibility">public</field>
        <field name="description_short" type="html"><p dir="rtl">حرّر بطاقة معرض بالعربية والإنجليزية وتتبّع كل ادعاء حتى مصدره قبل اعتماد النشر.</p></field>
        <field name="description" type="html"><div lang="ar" dir="rtl"><p>ورشة من ثلاث ساعات للمحررين ومنسقي المعارض ممن لديهم خبرة بصياغة نص للجمهور. تحتاج إلى محرر نصوص. جميع مواد الأرشيف والمسودات في هذه الحالة افتراضية، ويمكن إنجازها من دون حساب لدى أي خدمة.</p><p>تخرج ببطاقة ثنائية اللغة وسجل ادعاءات ومذكرة اعتماد تستطيع إعادة استخدامها في معرضك التالي.</p></div></field>
        <field name="image_1920" type="base64" file="nova_course_ai_cultural_work/static/img/workshop.jpg"/>
        <field name="is_published" eval="True"/>
    </record>

    <record id="section_1" model="slide.slide">
        <field name="name">تكليف المحرر وحدود الأرشيف</field>
        <field name="channel_id" ref="channel"/>
        <field name="is_category" eval="True"/>
        <field name="sequence">1</field>
        <field name="slide_category">document</field>
        <field name="is_published" eval="True"/>
    </record>

    <record id="slide_1_1" model="slide.slide">
        <field name="name">اختيار المواد المسموح بمعالجتها</field>
        <field name="channel_id" ref="channel"/>
        <field name="sequence">2</field>
        <field name="slide_category">article</field>
        <field name="completion_time">0.5</field>
        <field name="is_published" eval="True"/>
        <field name="is_preview" eval="True"/>
        <field name="description">افصل مواد العمل عن المواد التي أذن أصحابها باستخدامها للنشر.</field>
        <field name="html_content" type="html"><div dir="rtl" lang="ar" style="max-width:48rem;margin:auto;line-height:1.85;text-align:right;overflow-wrap:break-word;">
<p style="color:#324b77;font-size:1.2rem;font-weight:600;">افصل مواد العمل عن المواد التي أذن أصحابها باستخدامها للنشر.</p>
<h2>ملف المعرض</h2>
<dl class="row mx-0" style="background:#f0f4f5;color:#20343c;border-radius:.75rem;padding:.75rem;">
<div class="col-12 col-sm-4 py-1"><dt>وثيقة أ</dt><dd class="mb-0">بطاقة معتمدة</dd></div>
<div class="col-12 col-sm-4 py-1"><dt>وثيقة ب</dt><dd class="mb-0">رسالة خاصة</dd></div>
<div class="col-12 col-sm-4 py-1"><dt>وثيقة ج</dt><dd class="mb-0">مسودة تسويقية</dd></div>
</dl>
<p>يحتوي ملف معرض «أثر اليد» على ثلاث وثائق. أ: بطاقة معتمدة تقول إن المعرض يضم ١٨ طبعة على الورق ويفتح للجمهور في ١٢ أيار. ب: رسالة خاصة من فنانة تشرح سبب غيابها. ج: مسودة تسويقية تقول إن المعرض هو الأول في المنطقة، بلا مرجع. يطلب المنسق بطاقة من ٦٠ كلمة.</p>
<h2>طريقة العمل</h2>
<p>أنشئ سجل مدخلات. لكل وثيقة دوّن الغرض، ومن يملك صلاحية إتاحتها، وأقل مقتطف تحتاج إليه، وقرار الاستخدام. السماح بنشر البطاقة لا يمنح تلقائياً إذناً برفع كامل ملف العمل إلى خدمة خارجية. استخدم نص الحالة داخل مستندك.</p>
<div style="border-right:4px solid #324b77;background:#faf7f2;color:#29251f;padding:1rem;margin:1.25rem 0;"><h2>مهمتك</h2><p class="mb-0">صنّف الوثائق الثلاث، ودوّن ما تخسره تحريرياً عند استبعاد كل منها. اقترح سؤالاً محدداً لصاحب المصدر لسد الفجوة الأهم.</p></div>
<h2>راجع إجابتك</h2>
<p>تكفي أ لإثبات العدد والموعد. تستبعد ب من المعالجة لأن سبب الغياب شخصي وخارج غرض البطاقة. تُحجز صفة «الأول» حتى يتوفر مسح موثّق بنطاق جغرافي وزمني واضح. يمكن نشر بطاقة مفيدة دونها.</p>
</div></field>
    </record>

    <record id="slide_1_2" model="slide.slide">
        <field name="name">كتابة تكليف يمكن اختبار نتيجته</field>
        <field name="channel_id" ref="channel"/>
        <field name="sequence">3</field>
        <field name="slide_category">article</field>
        <field name="completion_time">0.5</field>
        <field name="is_published" eval="True"/>
        <field name="is_preview" eval="False"/>
        <field name="description">عرّف ما يُقبل من المسودة قبل توليدها.</field>
        <field name="html_content" type="html"><div dir="rtl" lang="ar" style="max-width:48rem;margin:auto;line-height:1.85;text-align:right;overflow-wrap:break-word;">
<p style="color:#324b77;font-size:1.2rem;font-weight:600;">عرّف ما يُقبل من المسودة قبل توليدها.</p>
<h2>عناصر التكليف</h2>
<dl class="row mx-0" style="background:#f0f4f5;color:#20343c;border-radius:.75rem;padding:.75rem;">
<div class="col-12 col-sm-4 py-1"><dt>المصادر</dt><dd class="mb-0">أ ود</dd></div>
<div class="col-12 col-sm-4 py-1"><dt>الجمهور</dt><dd class="mb-0">زائر عند المدخل</dd></div>
<div class="col-12 col-sm-4 py-1"><dt>التسليم</dt><dd class="mb-0">بطاقة وسجل أدلة</dd></div>
</dl>
<p>تضيف القيّمة وثيقة د معتمدة: «تُظهر طبعتان اختلاف الأثر عند تغيير ضغط اليد على الورق». يريد فريق الاتصال نصاً يستقبلك عند المدخل. لا تتضمن الوثيقتان أ ود اسم فنان أو عنوان مكان أو سنة إنتاج.</p>
<h2>طريقة العمل</h2>
<p>اكتب تكليفاً يحدد الجمهور، والوثائق المسموحة، وطول النص، وكيفية التعامل مع الفراغ. اطلب مسودة للزائر وجدولاً منفصلاً يطابق كل جملة خبرية بالوثيقة. حدّد اختبارين: هل احتفظ النص بالعدد؟ وهل أضاف سنة لم تُذكر؟</p>
<div style="border-right:4px solid #324b77;background:#faf7f2;color:#29251f;padding:1rem;margin:1.25rem 0;"><h2>مهمتك</h2><p class="mb-0">طبّق التكليف يدوياً أو في أداة معتمدة على النصين التدريبيين. اختبره بإضافة طلب منسق يقول «اذكر تاريخ تأسيس المعرض». سجّل كيف تتصرف عندما يتعارض الطلب مع الأدلة.</p></div>
<h2>راجع إجابتك</h2>
<p>تكليف صالح: «اكتب لزائر يدخل معرض أثر اليد. اعتمد أ ود فقط، واقترح سؤال ملاحظة يوجّه نظره إلى الطبعتين. ضع أي معلومة ناقصة في قائمة للمحرر». في سجل الاختبار تُترك سنة التأسيس للاستفسار، ولا تدخل البطاقة.</p>
</div></field>
    </record>

    <record id="slide_1_2_q1" model="slide.question">
        <field name="question">التكليف يطلب سنة التأسيس ولا تتضمنها الوثائق. ما الاستجابة التحريرية؟</field>
        <field name="sequence">1</field>
        <field name="slide_id" ref="slide_1_2"/>
    </record>
    <record id="slide_1_2_q1_a1" model="slide.answer">
        <field name="text_value">استخدام سنة الافتتاح</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="False"/>
        <field name="question_id" ref="slide_1_2_q1"/>
        <field name="comment">موعد افتتاح المعرض لا يثبت سنة التأسيس.</field>
    </record>
    <record id="slide_1_2_q1_a2" model="slide.answer">
        <field name="text_value">اعتماد السنة المتكررة في المسودات</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="False"/>
        <field name="question_id" ref="slide_1_2_q1"/>
        <field name="comment">قد تكرر المسودات الخطأ نفسه.</field>
    </record>
    <record id="slide_1_2_q1_a3" model="slide.answer">
        <field name="text_value">تسجيل سؤال للمحرر وحذف السنة من نص النشر</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="True"/>
        <field name="question_id" ref="slide_1_2_q1"/>
        <field name="comment">يظل النقص مرئياً للفريق دون تحويله إلى خبر.</field>
    </record>

    <record id="section_2" model="slide.slide">
        <field name="name">التحرير والترجمة والتحقق</field>
        <field name="channel_id" ref="channel"/>
        <field name="is_category" eval="True"/>
        <field name="sequence">4</field>
        <field name="slide_category">document</field>
        <field name="is_published" eval="True"/>
