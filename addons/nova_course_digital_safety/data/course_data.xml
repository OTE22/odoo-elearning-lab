<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="channel" model="slide.channel">
        <field name="name">إدارة المخاطر الرقمية واستمرارية العمل الثقافي</field>
        <field name="channel_type">training</field>
        <field name="enroll">public</field>
        <field name="visibility">public</field>
        <field name="description_short" type="html"><p dir="rtl">ضع خطة تشغيل لمهرجان يفقد الوصول إلى سجل الحجوزات، واختبر الصلاحيات والاستعادة بالأدلة.</p></field>
        <field name="description" type="html"><div lang="ar" dir="rtl"><p>ورشة عملية مدتها ساعتان ونصف لمسؤولي البرامج والعمليات ممن يديرون ملفات فريق. تحتاج إلى ورقة وقلم أو جدول بيانات. تُنفذ المحاكاة ببيانات مصطنعة وعلى الورق، ويمكن تطبيق اختبار الاستعادة على ملفات تدريبية منفصلة.</p><p>تنهي الورشة بسجل مخاطر ومصفوفة صلاحيات ومحضر استعادة يوضح متى يستطيع فريق الاستقبال العودة إلى العمل.</p></div></field>
        <field name="image_1920" type="base64" file="nova_course_digital_safety/static/img/workshop.jpg"/>
        <field name="is_published" eval="True"/>
    </record>

    <record id="section_1" model="slide.slide">
        <field name="name">العمليات الحرجة وحوكمة الوصول</field>
        <field name="channel_id" ref="channel"/>
        <field name="is_category" eval="True"/>
        <field name="sequence">1</field>
        <field name="slide_category">document</field>
        <field name="is_published" eval="True"/>
    </record>

    <record id="slide_1_1" model="slide.slide">
        <field name="name">تحديد الأثر وحدود الانقطاع</field>
        <field name="channel_id" ref="channel"/>
        <field name="sequence">2</field>
        <field name="slide_category">article</field>
        <field name="completion_time">0.5</field>
        <field name="is_published" eval="True"/>
        <field name="is_preview" eval="True"/>
        <field name="description">استخرج من جدول العرض هدفين قابلين للاختبار للاستعادة.</field>
        <field name="html_content" type="html"><div dir="rtl" lang="ar" style="max-width:48rem;margin:auto;line-height:1.85;text-align:right;overflow-wrap:break-word;">
<p style="color:#155852;font-size:1.2rem;font-weight:600;">استخرج من جدول العرض هدفين قابلين للاختبار للاستعادة.</p>
<h2>ساعة المهرجان</h2>
<dl class="row mx-0" style="background:#f0f4f5;color:#20343c;border-radius:.75rem;padding:.75rem;">
<div class="col-12 col-sm-4 py-1"><dt>التصدير</dt><dd class="mb-0">١٢ ظهراً</dd></div>
<div class="col-12 col-sm-4 py-1"><dt>توقف النظام</dt><dd class="mb-0">٥ مساءً</dd></div>
<div class="col-12 col-sm-4 py-1"><dt>فتح الأبواب</dt><dd class="mb-0">٦ مساءً</dd></div>
</dl>
<p>يفتح مهرجان افتراضي أبوابه عند السادسة. يحتاج الاستقبال إلى رمز الحجز وحالة الدخول، بينما تحتفظ المحاسبة بالفواتير. يوافق مدير التشغيل على إعادة خدمة الحجوزات خلال ساعة من توقفها وعلى فقد تعديلات لا تتجاوز ساعتين. آخر تصدير محفوظ عند الظهر.</p>
<h2>طريقة العمل</h2>
<p>زمن الاستعادة المستهدف يحدد كم يمكن أن يبقى الفريق دون الخدمة. أما نقطة الاستعادة المستهدفة فتحدد كم من التغييرات يمكن فقده. عند توقف النظام في الخامسة تعود نسخة الظهر بالفريق خمس ساعات إلى الوراء حتى لو فُتحت خلال دقائق.</p>
<div style="border-right:4px solid #155852;background:#faf7f2;color:#29251f;padding:1rem;margin:1.25rem 0;"><h2>مهمتك</h2><p class="mb-0">ارسم خطاً زمنياً من الظهر حتى السادسة. اكتب أثر فقدان حجز جديد وأثر فقدان فاتورة في عمل موظف الباب، ثم حدد الحقول الضرورية لنسخة استقبال مؤقتة ومن يملك قرار تفعيلها.</p></div>
<h2>راجع إجابتك</h2>
<p>نسخة الظهر تتجاوز هدف الفقد بثلاث ساعات. يمكن إعداد قائمة دخول مقيدة ذات توقيت معلوم مع إجراء منفصل لتسوية الحجوزات الأحدث. يقرر مدير التشغيل تفعيل البديل ويسجل موظف الباب الاستثناءات برموز الحجز فقط.</p>
</div></field>
    </record>

    <record id="slide_1_2" model="slide.slide">
        <field name="name">مراجعة الصلاحيات واستمرارية إدارة الحساب</field>
        <field name="channel_id" ref="channel"/>
        <field name="sequence">3</field>
        <field name="slide_category">article</field>
        <field name="completion_time">0.5</field>
        <field name="is_published" eval="True"/>
        <field name="is_preview" eval="False"/>
        <field name="description">وازن بين أقل قدر من الوصول وإمكانية استعادة الإدارة عند غياب المسؤول.</field>
        <field name="html_content" type="html"><div dir="rtl" lang="ar" style="max-width:48rem;margin:auto;line-height:1.85;text-align:right;overflow-wrap:break-word;">
<p style="color:#155852;font-size:1.2rem;font-weight:600;">وازن بين أقل قدر من الوصول وإمكانية استعادة الإدارة عند غياب المسؤول.</p>
<h2>خريطة الأدوار</h2>
<dl class="row mx-0" style="background:#f0f4f5;color:#20343c;border-radius:.75rem;padding:.75rem;">
<div class="col-12 col-sm-4 py-1"><dt>الاستقبال</dt><dd class="mb-0">تسجيل الدخول</dd></div>
<div class="col-12 col-sm-4 py-1"><dt>المحاسبة</dt><dd class="mb-0">ردّ المدفوعات</dd></div>
<div class="col-12 col-sm-4 py-1"><dt>التصميم</dt><dd class="mb-0">انتهى التكليف</dd></div>
</dl>
<p>تحتاج ليلى في الاستقبال إلى قراءة رمز الحجز وتسجيل الدخول. يتولى سامر ردّ المدفوعات. صممت متطوعة الملصق وانتهى تكليفها. تدير المنسقة الحساب وحدها وجهاز التحقق معها أثناء سفرها. يملك الثلاثة رابط تحرير المجلد كاملاً.</p>
<h2>طريقة العمل</h2>
<p>ارسم مصفوفة بأسماء الأدوار والأصول والعمليات وتاريخ انتهاء الحاجة. إذا لم تدعم المنصة تقييد الحقول، أنشئ عرضاً منفصلاً للاستقبال بالحقول الضرورية. عالج اعتماد الفريق على شخص واحد بتعيين مسؤول احتياطي له حساب مستقل وتحقق متعدد العوامل ومسار استرداد مضبوط.</p>
<div style="border-right:4px solid #155852;background:#faf7f2;color:#29251f;padding:1rem;margin:1.25rem 0;"><h2>مهمتك</h2><p class="mb-0">اكتب أربعة قرارات وصول وطريقة اختبار لكل قرار باستخدام أدوار تدريبية. أضف طريقة التعامل مع نسخة سبق تنزيلها لدى المتطوعة؛ إلغاء الرابط يحكم الوصول المستقبلي فقط.</p></div>
<h2>راجع إجابتك</h2>
<p>تتحقق ليلى من فتح قائمة الدخول وتعذّر فتح الفواتير. يختبر سامر صلاحية الرد بحساب تجريبي. يُلغى رابط التحرير السابق وتراجع عضويات المجلد، ويتابع المسؤول النسخ المنزلة وفق اتفاق العمل. يختبر المسؤول الاحتياطي دخول حسابه دون استعارة جهاز المنسقة.</p>
</div></field>
    </record>

